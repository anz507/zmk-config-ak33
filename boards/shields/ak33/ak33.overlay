#include <dt-bindings/zmk/matrix_transform.h>

/ {
    chosen {
        /* Tells ZMK to map this hardware matrix to your physical layout */
        zmk,kscan = &default_kscan;
        zmk,matrix-transform = &default_transform;
        zmk,underglow = &led_strip;
    };

    default_kscan: kscan {
        compatible = "zmk,kscan-gpio-matrix";
        label = "default_kscan";
        diode-direction = "col2row"; // options: "col2row" or "row2col"

        /* Define the micro-controller pins used for Rows */
        row-gpios
            = <&pro_micro 4 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>  // Row 0
            , <&pro_micro 5 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>  // Row 1
            , <&pro_micro 6 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>  // Row 2
            , <&pro_micro 7 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>  // Row 3
            ;

        /* Define the micro-controller pins used for Columns */
        col-gpios
            = <&pro_micro 14 GPIO_ACTIVE_HIGH> // Col 0
            , <&pro_micro 15 GPIO_ACTIVE_HIGH> // Col 1
            , <&pro_micro 18 GPIO_ACTIVE_HIGH> // Col 2
            , <&pro_micro 19 GPIO_ACTIVE_HIGH> // Col 3
            , <&pro_micro 20 GPIO_ACTIVE_HIGH> // Col 4
            , <&pro_micro 21 GPIO_ACTIVE_HIGH> // Col 5
            , <&pro_micro 8  GPIO_ACTIVE_HIGH> // Col 6
            , <&pro_micro 9  GPIO_ACTIVE_HIGH> // Col 7
            , <&pro_micro 10 GPIO_ACTIVE_HIGH> // Col 8
            , <&pro_micro 16 GPIO_ACTIVE_HIGH> // Col 9
            ;
    };

    default_transform: matrix_transform {
        compatible = "zmk,matrix-transform";
        rows = <4>;
        columns = <10>;

        map = <
            RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5) RC(0,6) RC(0,7) RC(0,8) RC(0,9)
            RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5) RC(1,6) RC(1,7) RC(1,8) RC(1,9)
            RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5) RC(2,6) RC(2,7) RC(2,8) RC(2,9)
            RC(3,0) RC(3,1) RC(3,2) RC(3,3) RC(3,4) RC(3,5) RC(3,6) RC(3,7) RC(3,8) RC(3,9)
        >;
    };

    led_strip: ws2812_strip {
        compatible = "worldsemi,ws2812b";
        chain-length = <29>;
        pin = <&pro_micro 1>;  // Adjust pin number as needed for your hardware
    };
};